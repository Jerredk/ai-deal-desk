# enterprise-deal-desk — local environment template (Anthropic-only)
# 1. cp .env.example .env
# 2. Paste your key from https://console.anthropic.com/
# 3. Never commit .env (it is gitignored)
#
# Required for live runs:
#   python -m src.agent --case-id GE-015 --version v3
#   python -m src.evals --versions v1 v2 v3
#
# Defaults (override via CLI flags, not env):
#   Agent / critic model : claude-sonnet-4-6   (--model / --agent-model)
#   LLM-as-a-Judge model : claude-opus-4-6     (--judge-model)
#   SQLite DB path       : db/deal_desk.db     (--db-path)

ANTHROPIC_API_KEY=
